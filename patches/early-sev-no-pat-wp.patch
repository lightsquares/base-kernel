+				    early_memremap_encrypted_wp(paddr, len);
+		} else {
+			src = enc ? early_memremap_decrypted(paddr, len) :
+				    early_memremap_encrypted(paddr, len);
+		}
 
 		dst = enc ? early_memremap_encrypted(paddr, len) :
 			    early_memremap_decrypted(paddr, len);
